---
import HeaderLink from './HeaderLink.astro';
import Navigation from './Navigation.astro';
import { SITE_TITLE } from '../consts';
import logo from '../assets/logo_white.ico';

const githubUrl = 'https://github.com/degersti';
---

<header>
	<nav class="header-nav">

		<!-- Logo + Seitentitel -->

		<a class="brand" href="/">
			<img src={logo} alt="degersti Logo" />
			<h2>{SITE_TITLE}</h2>
		</a>

		<!-- Desktop-Navigation -->

		<div class="navigation-links">
			<HeaderLink href="/">Startseite</HeaderLink>
			<HeaderLink href="/gateway">IoT Gateway</HeaderLink>
			<HeaderLink href="/devops">DevOps</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>

		<!-- GitHub + mobiles Menü -->

		<div class="header-actions">

			<a
				class="github-link"
				href={githubUrl}
				target="_blank"
				rel="noopener noreferrer"
				aria-label="GitHub-Profil öffnen"
			>
				<svg
					width="24"
					height="24"
					viewBox="0 0 24 24"
					fill="currentColor"
					aria-hidden="true"
				>
					<path
						d="M12 2C6.477 2 2 6.477 2 12c0 4.419 2.865 8.166
						6.839 9.489.5.092.682-.217.682-.482
						0-.237-.009-.866-.014-1.7-2.782.604-3.369-1.341-3.369-1.341
						-.455-1.157-1.11-1.465-1.11-1.465
						-.908-.62.069-.608.069-.608
						1.004.071 1.532 1.031 1.532 1.031
						.892 1.529 2.341 1.087 2.91.831
						.091-.646.349-1.087.635-1.337
						-2.221-.253-4.555-1.111-4.555-4.944
						0-1.091.39-1.984 1.029-2.683
						-.103-.253-.446-1.269.098-2.644
						0 0 .84-.269 2.75 1.025
						A9.564 9.564 0 0 1 12 6.844
						a9.56 9.56 0 0 1 2.504.337
						c1.909-1.294 2.748-1.025 2.748-1.025
						.546 1.375.203 2.391.1 2.644
						.64.699 1.028 1.592 1.028 2.683
						0 3.842-2.337 4.687-4.566 4.935
						.359.309.678.919.678 1.852
						0 1.337-.012 2.416-.012 2.744
						0 .267.18.578.688.48
						A10.004 10.004 0 0 0 22 12
						C22 6.477 17.523 2 12 2z"
					/>
				</svg>
			</a>

			<button
				class="menu-toggle"
				type="button"
				aria-label="Navigation öffnen"
				aria-expanded="false"
				aria-controls="mobile-navigation"
			>
				<span></span>
				<span></span>
				<span></span>
			</button>

		</div>

	</nav>

	<!-- Mobile Navigation -->

	<div
		id="mobile-navigation"
		class="mobile-navigation"
	>
		<Navigation />
	</div>

</header>

<script>
	const menuButton =
		document.querySelector<HTMLButtonElement>('.menu-toggle');

	const mobileNavigation =
		document.querySelector<HTMLElement>('.mobile-navigation');

	function closeMenu() {
		menuButton?.setAttribute('aria-expanded', 'false');
		menuButton?.setAttribute('aria-label', 'Navigation öffnen');

		mobileNavigation?.classList.remove('is-open');
	}

	menuButton?.addEventListener('click', () => {
		const isOpen =
			menuButton.getAttribute('aria-expanded') === 'true';

		menuButton.setAttribute(
			'aria-expanded',
			String(!isOpen)
		);

		menuButton.setAttribute(
			'aria-label',
			isOpen
				? 'Navigation öffnen'
				: 'Navigation schließen'
		);

		mobileNavigation?.classList.toggle(
			'is-open',
			!isOpen
		);
	});

	mobileNavigation?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', closeMenu);
	});
</script>

<style>
	header {
		position: relative;
		z-index: 1000;

		background: linear-gradient(
			180deg,
			#2a3656 0%,
			#202a44 100%
		);

		color: white;

		box-shadow: 0 6px 20px rgba(32, 42, 68, 0.18);
	}

	.header-nav {
		font-family: "Space Grotesk", sans-serif;
		position: relative;

		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;

		width: 100%;
		min-height: 64px;

		padding-inline: 1.25rem;
	}

	/* --------------------------------------------------
	   Logo + Titel
	   -------------------------------------------------- */

	.brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;

		padding: 0.5rem;

		color: white;
		text-decoration: none;

		justify-self: start;
	}

	.brand img {
		width: 36px;
		height: 36px;

		object-fit: contain;
		flex-shrink: 0;
	}

	.brand h2 {
		margin: 0;

		color: white;
		font-size: 1.75rem;
	}

	/* --------------------------------------------------
	   Desktop Navigation
	   -------------------------------------------------- */

	.navigation-links {
		display: flex;
		align-items: center;
		justify-content: center;

		justify-self: center;
	}

	.navigation-links a {
		padding: 1.25rem 0.75rem;

		color: white;
		border-bottom: 4px solid transparent;

		text-decoration: none;
		white-space: nowrap;
	}

	.navigation-links a:hover {
		background: rgba(255, 255, 255, 0.08);
	}

	.navigation-links a.active {
		border-bottom-color: var(--accent);
	}

	/* --------------------------------------------------
	   Rechter Bereich
	   -------------------------------------------------- */

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.25rem;

		justify-self: end;
	}

	.github-link {
		display: flex;
		align-items: center;
		justify-content: center;

		color: white;
	}

	.github-link svg {
		width: 40px;
		height: 40px;
	}

	/* --------------------------------------------------
	   Hamburger
	   -------------------------------------------------- */

	.menu-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		align-items: center;

		gap: 5px;

		width: 44px;
		height: 44px;
		padding: 8px;

		color: white;
		background: transparent;

		border: 0;
		border-radius: 6px;

		cursor: pointer;
	}

	.menu-toggle:hover {
		background: rgba(255, 255, 255, 0.1);
	}

	.menu-toggle span {
		display: block;

		width: 26px;
		height: 2px;

		background: currentColor;
		border-radius: 2px;

		transition:
			transform 0.2s ease,
			opacity 0.2s ease;
	}

	.menu-toggle[aria-expanded='true'] span:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}

	.menu-toggle[aria-expanded='true'] span:nth-child(2) {
		opacity: 0;
	}

	.menu-toggle[aria-expanded='true'] span:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	/* --------------------------------------------------
	   Mobile Navigation
	   -------------------------------------------------- */

	.mobile-navigation {
		display: none;
	}

	@media (max-width: 720px) {

		.header-nav {
			grid-template-columns: 1fr auto;

			width: 100%;
			min-height: 60px;

			padding-inline: 0.75rem;
		}

		/* Logo */

		.brand {
			padding: 0.5rem 0;
			justify-self: start;
		}

		.brand img {
			width: 32px;
			height: 32px;
		}

		.brand h2 {
			font-size: 0.95rem;
		}

		/* Desktop Navigation ausblenden */

		.navigation-links {
			display: none;
		}

		/* GitHub mobil ausblenden */

		.github-link {
			display: none;
		}

		/* Hamburger anzeigen */

		.header-actions {
			justify-self: end;
		}

		.menu-toggle {
			display: flex;
		}

		/* --------------------------------------------------
		   Vollständiges mobiles Menü
		   -------------------------------------------------- */

		.mobile-navigation {
			display: none;

			position: absolute;

			top: 100%;
			left: 0;
			right: 0;

			max-height: calc(100vh - 60px);

			overflow-y: auto;

			padding: 1rem;

			background: #202a44;

			color: white;

			box-shadow: 0 12px 20px rgba(0, 0, 0, 0.2);
		}

		.mobile-navigation.is-open {
			display: block;
		}
	}
</style>