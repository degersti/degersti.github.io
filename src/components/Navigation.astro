---
const currentPath = Astro.url.pathname;

const isActive = (path: string) => currentPath === path;

const isGateway = currentPath.startsWith('/gateway');
const isDevOps = currentPath.startsWith('/devops');
const isGit = currentPath.startsWith('/devops/git');

import {
	House,
	Cpu,
	Infinity,
	GitBranch,
	Terminal,
	Container,
	Boxes,
	Network,
	Cloud,
	UserRound
} from '@lucide/astro';
---

<nav class="sidebar-nav" aria-label="Seitennavigation">

	<!-- ==================================================
	     STARTSEITE
	     ================================================== -->

	<a href="/" class:list={["sidebar-link","main-link",{ active: isActive("/") }]}>
		<House size={18} />
		<span>Startseite</span>
	</a>

	<!-- ==================================================
	     IOT GATEWAY
	     ================================================== -->

	<div class="sidebar-section">
		<div class="section-header">

			<a href="/gateway/"	class:list={["sidebar-link","main-link",{ active: isActive("/gateway/") }]}>
				<Cpu size={18} />
				<span>IoT Gateway</span>
			</a>

			<details open={isGateway}>
				<summary
					aria-label="IoT-Gateway-Menü ein- oder ausklappen"
				></summary>

				<!-- Gateway-Unterpunkte -->

			</details>

		</div>
	</div>

	<!-- ==================================================
	     DEVOPS
	     ================================================== -->

	<div class="sidebar-section">
		<div class="section-header">

			<a href="/devops/" class:list={["sidebar-link",	"main-link",{ active: isActive("/devops/") }]}>
				<Infinity size={18} />
				<span>DevOps</span>
			</a>

			<details open={isDevOps}>
				<summary
					aria-label="DevOps-Menü ein- oder ausklappen"
				></summary>

				<div class="sidebar-group">

					<!-- ----------------------------------------------
					     VERSIONSVERWALTUNG
					     ---------------------------------------------- -->

					<div class="sidebar-section">
						<div class="section-header">

							<a	href="/devops/git/"	class:list={["sidebar-link", { active: isActive("/devops/git/") }]}>
								<GitBranch size={18} />
								<span>Versionsverwaltung</span>
							</a>

							<details open={isGit}>
								<summary
									aria-label="Versionsverwaltungs-Menü ein- oder ausklappen"
								></summary>

								<div class="sidebar-group nested">

									<!-- Was ist Versionsverwaltung? -->

									<a
										href="/devops/git/#was-ist-versionsverwaltung"
										class="sidebar-link"
									>
										Einführung
									</a>

									<!-- Wie funktioniert Git? -->

									<a
										href="/devops/git/#wie-funktioniert-git"
										class="sidebar-link"
									>
										Git-Erklärt
									</a>

									<!-- Git installieren und einrichten -->

									<a
										href="/devops/git/#git-installieren-und-einrichten"
										class="sidebar-link"
									>
										Git Installation
									</a>

									<!-- Ein lokales Git Repository erstellen -->

									<a
										href="/devops/git/#ein-lokales-git-repository-erstellen"
										class="sidebar-link"
									>
										Repository erstellen
									</a>

									<!-- Speichern und Commiten -->

									<a
										href="/devops/git/#speichern-und-commiten"
										class="sidebar-link"
									>
										Speichern und Commiten
									</a>

									<!-- Conventional Commits -->

									<a
										href="/devops/git/#conventional-commits"
										class="sidebar-link"
									>
										Conventional Commits
									</a>

									<!-- Prüfen und Wiederherstellen -->

									<a
										href="/devops/git/#pruefen-und-wiederherstellen"
										class="sidebar-link"
									>
										Prüfen und Wiederherstellen
									</a>

									<!-- Mit Verzweigungen arbeiten -->

									<a
										href="/devops/git/#mit-verzweigungen-arbeiten"
										class="sidebar-link"
									>
										Branches
									</a>

									<!-- Was ist GitHub? -->

									<a
										href="/devops/git/#was-ist-github"
										class="sidebar-link"
									>
										Was ist GitHub?
									</a>

									<!-- Git und GitHub verbinden -->

									<a
										href="/devops/git/#git-und-github-verbinden"
										class="sidebar-link"
									>
										Git und GitHub verbinden
									</a>

									<!-- Beispielprojekt -->

									<a
										href="/devops/git-beispielprojekt"
										class="sidebar-link"
									>
										Beispielprojekt
									</a>

									<!-- Zum Nachschlagen -->

									<a
										href="/devops/git/#git-quellen"
										class="sidebar-link"
									>
										Quellen
									</a>

								</div>
							</details>

						</div>
					</div>

					<!-- -------- ENDE VERSIONSVERWALTUNG -------- -->

					<!-- ----------------------------------------------
					     WEITERE DEVOPS-THEMEN
					     ---------------------------------------------- -->

					<!--
					<a
						href="/devops/linux/"
						class:list={[
							"sidebar-link",
							{ active: isActive("/devops/linux/") }
						]}
					>
						Linux
					</a>

					<a
						href="/devops/docker/"
						class:list={[
							"sidebar-link",
							{ active: isActive("/devops/docker/") }
						]}
					>
						Docker
					</a>
					-->

				</div>
			</details>

		</div>
	</div>

	<!-- ================= ENDE DEVOPS ================= -->

	<!-- ==================================================
	     ABOUT
	     ================================================== -->

	<div class="sidebar-section">
		<div class="section-header">

			<a href="/about/" class:list={["sidebar-link", "main-link",	{ active: isActive("/about/") }]}>
				<UserRound size={18} />
				<span>About</span>
			</a>

		</div>
	</div>

	<!-- ================= ENDE ABOUT ================= -->

</nav>

<style>
	.sidebar-nav {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.sidebar-section {
		display: flex;
		flex-direction: column;
	}

	.section-header {
		position: relative;
	}

	.sidebar-link {
		display: flex;
		align-items: center;
		gap: 0.6rem;

		padding: 0.2rem 0.2rem;

		color: inherit;
		text-decoration: none;

		border-radius: 6px;
	}

	.sidebar-link:hover {
		background: rgba(0, 0, 0, 0.05);
	}

	.main-link {
		font-weight: 600;
		padding-right: 2rem;
	}

	.sidebar-link.active {
		background: rgba(0, 0, 0, 0.08);
		font-weight: 600;
	}

	.section-header > details {
		display: contents;
	}

	.section-header > details > summary {
		position: absolute;

		top: 0;
		right: 0;

		width: 2rem;
		height: 2rem;

		cursor: pointer;
		list-style: none;
	}

	.section-header > details > summary::-webkit-details-marker {
		display: none;
	}

	.section-header > details > summary::after {
		content: "›";

		position: absolute;

		top: 50%;
		left: 50%;

		transform: translate(-50%, -50%) rotate(0deg);

		font-size: 1.2rem;

		transition: transform 0.2s ease;
	}

	.section-header > details[open] > summary::after {
		transform: translate(-50%, -50%) rotate(90deg);
	}

	.sidebar-group {
		display: flex;
		flex-direction: column;

		margin-left: 0.7rem;
		padding-left: 0.6rem;

		border-left: 1px solid rgba(0, 0, 0, 0.12);
	}

	.sidebar-group.nested {
		margin-left: 0.8rem;
	}

	details {
		margin: 0;
	}
</style>