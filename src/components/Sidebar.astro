---
import Navigation from './Navigation.astro';
---

<aside class="sidebar">
	<Navigation />
</aside>

<style>
	.sidebar {
		width: clamp(280px, 20vw, 340px);
		flex-shrink: 0;

		padding: 1.5rem 1rem;

		border-right: 1px solid rgba(0, 0, 0, 0.1);

		position: sticky;
		top: 0;
		align-self: flex-start;

		max-height: 100vh;
		overflow-y: auto;
	}

	@media (max-width: 768px) {
		.sidebar {
			display: none;
		}
	}
</style>