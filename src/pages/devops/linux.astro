<script>
	function closeOtherChapters(currentDetails: HTMLDetailsElement) {
		document
			.querySelectorAll<HTMLDetailsElement>(".chapter details")
			.forEach((details) => {
				if (details !== currentDetails) {
					details.open = false;
				}
			});
	}

	// --------------------------------------------------
	// Kapitel per Klick öffnen
	// --------------------------------------------------

	document
		.querySelectorAll<HTMLDetailsElement>(".chapter details")
		.forEach((details) => {
			const summary = details.querySelector("summary");

			if (!summary) return;

			summary.addEventListener("click", () => {
				// Nur relevant, wenn das Kapitel gerade geschlossen ist
				if (details.open) return;

				// Position des Kapitels im sichtbaren Bereich merken
				const oldTop = details.getBoundingClientRect().top;

				requestAnimationFrame(() => {
					closeOtherChapters(details);

					requestAnimationFrame(() => {
						const newTop = details.getBoundingClientRect().top;

						// Verschiebung durch das Einklappen ausgleichen
						window.scrollBy({
							top: newTop - oldTop,
							behavior: "instant"
						});
					});
				});
			});
		});

	// --------------------------------------------------
	// Kapitel über #anker öffnen
	// --------------------------------------------------

	function openTargetChapter() {
		if (!window.location.hash) return;

		const target = document.querySelector(window.location.hash);

		if (!target) return;

		const details = target.closest<HTMLDetailsElement>("details");

		if (!details) return;

		closeOtherChapters(details);
		details.open = true;

		requestAnimationFrame(() => {
			target.scrollIntoView({
				behavior: "smooth",
				block: "start"
			});
		});
	}

	// Direkter Seitenaufruf mit #anker
	openTargetChapter();

	// Wechsel zu einem anderen #anker
	window.addEventListener("hashchange", openTargetChapter);
</script>